      ],
      "id": "6c559515-67f5-4e86-9489-d21e69fa7a27",
      "name": "Identificar pedido entrante"
    },
    {
      "parameters": {
        "mode": "chooseBranch"
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1136,
        -160
      ],
      "id": "32fa6a73-4c35-4f53-9a2f-f9ee5c22e1b1",
      "name": "Esperar consulta de sheets"
    },
    {
      "parameters": {
        "jsCode": "// Pedidos nuevos recibidos desde el Webhook\nconst pedidosNuevos = $input.all();\n\n// Registros existentes en Google Sheets\nconst pedidosRegistrados =\n  $('Consultar pedidos registrados').all()\n    .map(item => item.json);\n\n// Normalizar textos para comparar correctamente\nfunction normalizar(valor) {\n  return String(valor ?? '')\n    .trim()\n    .replace(/\\s+/g, ' ')\n    .toUpperCase();\n}\n\n// Normalizar fechas\nfunction normalizarFecha(valor) {\n  const texto = normalizar(valor);\n\n  const partes = texto.match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);\n\n  if (partes) {\n    return `${partes[3]}-${partes[2]}-${partes[1]}`;\n  }\n\n  return texto;\n}\n\n// Obtener el identificador del pedido\nfunction obtenerId(pedido) {\n\n  if (normalizar(pedido.id_pedido)) {\n    return normalizar(pedido.id_pedido)\n      .replace(/\\s+/g, '_');\n  }\n\n  // Contemplar registros antiguos sin id_pedido\n  if (!normalizar(pedido.id_paciente)) {\n    return '';\n  }\n\n  return [\n    pedido.clinica,\n    normalizarFecha(pedido.fecha),\n    pedido.servicio,\n    pedido.id_paciente\n  ]\n    .map(v => normalizar(v).replace(/\\s+/g, '_'))\n    .join('_');\n}\n\n// Campos utilizados para detectar modificaciones\nconst camposComparacion = [\n  'clinica',\n  'fecha',\n  'servicio',\n  'id_paciente',\n  'habitacion',\n  'menu',\n  'adaptacion'\n];\n\n// Campos reservados para la nutricionista\nconst camposNutricionista = [\n  'estado_nutricion',\n  'nutricionista',\n  'fecha_aprobacion',\n  'observaciones_nutricionista'\n];\n\nreturn pedidosNuevos.map((item, index) => {\n\n  const pedido = item.json;\n\n  const idPedido = normalizar(pedido.id_pedido);\n\n  if (!idPedido) {\n    throw new Error(\n      'El pedido recibido no tiene un id_pedido válido.'\n    );\n  }\n\n  // Buscar coincidencias en Google Sheets\n  const encontrados = pedidosRegistrados\n    .filter(registro =>\n      obtenerId(registro) === idPedido\n    )\n    .sort((a, b) =>\n      Number(b.row_number || 0) -\n      Number(a.row_number || 0)\n    );\n\n  const anterior = encontrados[0];\n\n  let control_duplicado;\n\n  // CONTROL 1: Pedido nuevo\n  if (!anterior) {\n\n    control_duplicado = 'NUEVO';\n\n  } else {\n\n    // CONTROL 2: Verificar intervención nutricional\n    // Se revisan todas las coincidencias encontradas.\n\n    const tieneIntervencion = encontrados.some(registro =>\n      camposNutricionista.some(campo =>\n        normalizar(registro[campo]) !== ''\n      )\n    );\n\n    if (tieneIntervencion) {\n\n      control_duplicado =\n        'PROTEGIDO_POR_NUTRICIONISTA';\n\n    } else {\n\n      // CONTROL 3: Comparar los datos del pedido\n\n      const sinCambios = camposComparacion.every(campo => {\n\n        if (campo === 'fecha') {\n          return normalizarFecha(pedido[campo]) ===\n                 normalizarFecha(anterior[campo]);\n        }\n\n        return normalizar(pedido[campo]) ===\n               normalizar(anterior[campo]);\n\n      });\n\n      control_duplicado = sinCambios\n        ? 'REPETIDO_SIN_CAMBIOS'\n        : 'EXISTENTE_MODIFICADO';\n\n    }\n  }\n\n  return {\n    json: {\n      ...pedido,\n      control_duplicado\n    },\n\n    pairedItem: {\n      item: index\n    }\n  };\n\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        0
      ],
      "id": "7d37397c-500e-4b8e-9660-b1a21856a0a1",
      "name": "Control pedidos duplicados"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "7ee97637-5c89-4416-a373-e43637ece89d",
              "leftValue": "={{ ['NUEVO', 'EXISTENTE_MODIFICADO'].includes(String($json.control_duplicado ?? '').trim().toUpperCase()) }}",
              "rightValue": "REPETIDO_SIN_CAMBIOS",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
