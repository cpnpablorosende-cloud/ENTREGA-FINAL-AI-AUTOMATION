      ],
      "id": "77074f3d-58ee-419f-8689-7b1d7785bbdc",
      "name": "Pedido nuevo o modificado?"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n\n  // Recuperar los datos originales del pedido\n  const pedido = $('Edit Fields').itemMatching(index).json;\n\n  // Conservar el identificador original\n  const id_pedido = String(pedido.id_pedido ?? '').trim();\n\n  if (!id_pedido) {\n    throw new Error(\"El pedido no tiene un id_pedido válido.\");\n  }\n\n  // Interpretar la respuesta del AI Agent\n  let respuesta;\n\n  try {\n    respuesta = JSON.parse(item.json.output);\n  } catch (error) {\n    respuesta = {};\n  }\n\n  // Recuperar la decisión del agente\n  let decision = String(respuesta.decision ?? '')\n    .trim()\n    .toUpperCase();\n\n  let motivo = String(respuesta.motivo ?? '').trim();\n\n  let mensaje = typeof respuesta.mensaje_whatsapp === 'string'\n    ? respuesta.mensaje_whatsapp.trim()\n    : '';\n\n  // CONTROL 1:\n  // Verificar que la decisión sea válida\n\n  if (![\"SOLICITAR_DATOS\", \"DERIVAR_HUMANO\"].includes(decision)) {\n\n    decision = \"DERIVAR_HUMANO\";\n\n    motivo = \"El agente devolvió una decisión no válida.\";\n  }\n\n  // CONTROL 2:\n  // Si falta el identificador del paciente,\n  // siempre debe intervenir una persona.\n\n  if (!String(pedido.id_paciente ?? '').trim()) {\n\n    decision = \"DERIVAR_HUMANO\";\n\n    motivo = \"Falta el identificador del paciente. Requiere revisión humana.\";\n\n    mensaje = \"\";\n  }\n\n  // CONTROL 3:\n  // Si el agente solicita información pero\n  // no genera un mensaje válido, derivar.\n\n  if (\n    decision === \"SOLICITAR_DATOS\" &&\n    !mensaje.trim()\n  ) {\n\n    decision = \"DERIVAR_HUMANO\";\n\n    motivo = \"El agente no generó un mensaje válido.\";\n  }\n\n  // CONTROL 4:\n  // Las derivaciones humanas no generan\n  // mensajes automáticos a la clínica.\n\n  if (decision === \"DERIVAR_HUMANO\") {\n\n    mensaje = \"\";\n  }\n\n  // Devolver los datos y la decisión validada\n\n  return {\n\n    json: {\n\n      ...pedido,\n\n      clinica: String(pedido.clinica ?? '').trim(),\n\n      id_pedido: id_pedido,\n\n      decision: decision,\n\n      motivo: motivo,\n\n      mensaje_whatsapp: mensaje,\n\n      id_derivacion:\n        id_pedido + \"_\" + Date.now() + \"_\" + (index + 1),\n\n      estado_derivacion:\n        decision === \"DERIVAR_HUMANO\"\n          ? \"PENDIENTE_REVISION_HUMANA\"\n          : \"\"\n\n    },\n\n    pairedItem: {\n      item: index\n    }\n\n  };\n\n});"
      },
