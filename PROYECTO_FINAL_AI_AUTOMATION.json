    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5ddf06c0-0ef7-407c-9083-68dcd31f8754",
              "name": "id_pedido",
              "value": "={{ [\n  $json.clinica,\n  $json.fecha,\n  $json.servicio,\n  String($json.id_paciente ?? '').trim() ||\n    ('SIN_ID_' + Date.now() + '_' + $itemIndex)\n].map(v =>\n  String(v ?? '')\n    .trim()\n    .toUpperCase()\n    .replace(/\\s+/g, '_')\n).join('_') }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
